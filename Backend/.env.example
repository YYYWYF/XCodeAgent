# 需要更新本地的env文件
MODEL_PROVIDER=openai #openai格式的
MODEL_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
MODEL_API_KEY=replace-with-your-token
MODEL_NAME="mimo-v2.5-pro [1m]"

ANTHROPIC_DEFAULT_HAIKU_MODEL="mimo-v2.5-pro [1m]"
ANTHROPIC_DEFAULT_SONNET_MODEL="mimo-v2.5-pro [1m]"
ANTHROPIC_DEFAULT_OPUS_MODEL="mimo-v2.5-pro [1m]"
ANTHROPIC_REASONING_MODEL="mimo-v2.5-pro [1m]"

# Optional: set true only when the model client should read HTTP(S)/SOCKS proxy
# variables from the shell environment. Defaults to false for reliable local startup.
ANTHROPIC_TRUST_ENV=false

# Optional: offline Ant Design v4.24.16 component docs used by the built-in docs tool.
ANTD_V4_DOCS_DIR=/Users/yifei/Documents/antd-components

# Optional: default workspace when a tool request does not pass workspace_root.
XCODEAGENT_WORKSPACE_ROOT=/Users/yifei/Documents/example-workspace
