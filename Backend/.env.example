MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=replace-with-your-token
MODEL_NAME=gpt-4.1-mini
MODEL_TRUST_ENV=false
MODEL_OUTPUT_LOG_ENABLED=false

# TechnicalPlan 完整生成与 Contract 修复的输出上限，独立于 AGENT_MAX_TOKENS。
XCODEAGENT_TECHNICAL_PLAN_MAX_TOKENS=32768

# UI 设计稿单页生成上限、校验失败后的自动修复次数，以及解耦式并发生成池的 worker 并发数。
XCODEAGENT_UI_DESIGN_MAX_TOKENS=8192
XCODEAGENT_UI_DESIGN_MAX_RETRIES=1
XCODEAGENT_UI_DESIGN_CONCURRENCY=3

# UI 设计稿节点独立模型（可选）。三项（BASE_URL/API_KEY/NAME）同时配置才生效，
# 缺任一项回落全局 MODEL_*。GLM-5.2 等推理模型在长代码任务上 thinking 压不掉、
# 生成耗时翻倍；给 UI 节点单配非推理模型（如 DeepSeek-V4 Pro，官方 API 真正支持
# thinking 开关）可显著缩短生成时间，其他节点继续用全局模型。
# PROVIDER/CUSTOM_HEADERS/TRUST_ENV 缺省跟随全局 MODEL_* 对应值。
# UI_DESIGN_MODEL_PROVIDER=openai
# UI_DESIGN_MODEL_BASE_URL=https://api.deepseek.com/v1
# UI_DESIGN_MODEL_API_KEY=replace-with-deepseek-token
# UI_DESIGN_MODEL_NAME=deepseek-v4-pro
# UI_DESIGN_MODEL_CUSTOM_HEADERS=
# UI_DESIGN_MODEL_TRUST_ENV=false

# Build DAG 候选任务违反平台边界或 DAG 校验失败后的自动重生成次数。
BUILD_TASK_PLAN_MAX_RETRIES=2

# DAG Unit Generation 专属配置，与 AGENT_MAX_TOKENS、MODEL_MAX_RETRIES 独立。
# token、并发必须 >= 1；第一版 Local attempts 固定 3、Global repair rounds 固定 2，不开放环境覆盖。
# 本阶段仅加载配置，尚未接入模型或 Scheduler，不改变当前运行并发。
XCODEAGENT_DAG_UNIT_MAX_TOKENS=4096
XCODEAGENT_DAG_UNIT_CONCURRENCY=3

# DAG 执行阶段是否开展业务自检；默认关闭，开启后执行现有业务校验与失败处理。
XCODEAGENT_DAG_BUSINESS_SELF_CHECK_ENABLED=false

XCODEAGENT_WORKSPACE_ROOT=/path/to/example-workspace
XCODEAGENT_ENDPOINT_DATABASE_CONTEXT_ENABLED=true

# 首次 Bootstrap 模板源：engine（生产默认）或 git（本地公开仓库调试，无需 Engine Token）。
XCODEAGENT_TEMPLATE_BOOTSTRAP_SOURCE=engine

# Git 模式沿用三端模板来源；有业务 Agent 时才拉取 agent-runtime@master。
XCODEAGENT_TEMPLATE_GIT_FRONTEND_REPOSITORY_URL=https://github.com/ruyue1/frontend-template.git
XCODEAGENT_TEMPLATE_GIT_BACKEND_REPOSITORY_URL=https://github.com/Hupy2118/springboot-template.git
XCODEAGENT_TEMPLATE_GIT_AGENT_RUNTIME_REPOSITORY_URL=https://github.com/Bettetman/agent-runtime-template.git
XCODEAGENT_TEMPLATE_GIT_AGENT_RUNTIME_BRANCH=master
XCODEAGENT_TEMPLATE_GIT_CLONE_TIMEOUT_SECONDS=120

# Template Engine：engine 模式仅由 Backend 使用，Renderer 不持有此凭据。
XCODEAGENT_TEMPLATE_ENGINE_BASE_URL=http://127.0.0.1:18080
XCODEAGENT_TEMPLATE_ENGINE_TOKEN=stage3-demo-token
XCODEAGENT_TEMPLATE_ENGINE_CONNECT_TIMEOUT_SECONDS=10
XCODEAGENT_TEMPLATE_ENGINE_READ_TIMEOUT_SECONDS=120
XCODEAGENT_TEMPLATE_PACKAGE_MAX_BYTES=104857600
XCODEAGENT_TEMPLATE_PACKAGE_MAX_FILES=10000
XCODEAGENT_TEMPLATE_PACKAGE_MAX_EXTRACTED_BYTES=524288000
# 是否开启模板能力二次注入；git 本地调试模式应关闭，二次注入仍由 Engine V2 提供。
XCODEAGENT_TEMPLATE_RECONCILE_ENABLED=true

# Embedded code-review-graph indexing. The foreground wait is bounded; after
# the timeout the workflow continues with file search while the index builds.
XCODEAGENT_CODE_GRAPH_TIMEOUT_SECONDS=30

# Workflow checkpoint retention. Checkpoint DB defaults to:
# {workspace}/.xcodeagent/checkpoints/checkpoints.sqlite
XCODEAGENT_CHECKPOINT_RETENTION_DAYS=30
# Optional override. If set, all workflow runs share this DB.
# XCODEAGENT_CHECKPOINT_DB=/path/to/checkpoints.sqlite

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=xcodeagent-workflow
LANGSMITH_ENDPOINT=

# 数据库信息查询，默认不打开
XCODEAGENT_ENDPOINT_DATABASE_CONTEXT_ENABLED=false
