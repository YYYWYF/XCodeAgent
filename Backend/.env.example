MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=replace-with-your-token
MODEL_NAME=gpt-4.1-mini
MODEL_TRUST_ENV=false
MODEL_OUTPUT_LOG_ENABLED=false

XCODEAGENT_WORKSPACE_ROOT=/path/to/example-workspace

# Workflow checkpoint retention. Checkpoint DB defaults to:
# {workspace}/.xcodeagent/checkpoints/checkpoints.sqlite
XCODEAGENT_CHECKPOINT_RETENTION_DAYS=30
# Optional override. If set, all workflow runs share this DB.
# XCODEAGENT_CHECKPOINT_DB=/path/to/checkpoints.sqlite

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=xcodeagent-workflow
LANGSMITH_ENDPOINT=

# 数据库信息查询，默认不打开
XCODEAGENT_ENDPOINT_DATABASE_CONTEXT_ENABLED=false
