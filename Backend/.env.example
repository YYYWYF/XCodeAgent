# 只连接 code8 转发服务；实际上游模型、地址、密钥由服务配置。
MODEL_TRANSMIT_URL=http://127.0.0.1:8100
MODEL_TRANSMIT_TOKEN=replace-with-service-token
MODEL_TRANSMIT_TRUST_ENV=false
MODEL_TRANSMIT_SPAID=
MODEL_OUTPUT_LOG_ENABLED=false
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2

# UI 设计稿单页生成上限、校验失败后的自动修复次数，以及解耦式并发生成池的 worker 并发数。
DEVAGENTSTUDIO_UI_DESIGN_MAX_TOKENS=8192
DEVAGENTSTUDIO_UI_DESIGN_MAX_RETRIES=1
DEVAGENTSTUDIO_UI_DESIGN_CONCURRENCY=3

# UI 独立转发地址（可选）；留空复用全局服务。
# 独立服务使用另一端口和独立 SQLite；不同模型仍由该服务端配置。
UI_DESIGN_MODEL_TRANSMIT_URL=
UI_DESIGN_MODEL_TRANSMIT_TOKEN=
# UI_DESIGN_MODEL_TRANSMIT_TRUST_ENV=false
# UI_DESIGN_MODEL_TRANSMIT_SPAID=

# Build DAG 候选任务违反平台边界或 DAG 校验失败后的自动重生成次数。
BUILD_TASK_PLAN_MAX_RETRIES=2

# DAG Unit Generation 专属配置，与 AGENT_MAX_TOKENS、MODEL_MAX_RETRIES 独立。
# token、并发必须 >= 1；第一版 Local attempts 固定 3、Global repair rounds 固定 2，不开放环境覆盖。
# 本阶段仅加载配置，尚未接入模型或 Scheduler，不改变当前运行并发。
DEVAGENTSTUDIO_DAG_UNIT_MAX_TOKENS=4096
DEVAGENTSTUDIO_DAG_UNIT_CONCURRENCY=3

# DAG 执行阶段是否开展业务自检；默认关闭，开启后执行现有业务校验与失败处理。
DEVAGENTSTUDIO_DAG_BUSINESS_SELF_CHECK_ENABLED=false

DEVAGENTSTUDIO_WORKSPACE_ROOT=/path/to/example-workspace
DEVAGENTSTUDIO_ENDPOINT_DATABASE_CONTEXT_ENABLED=true

# Template Engine：首次 Bootstrap 仅由 Backend 使用，Renderer 不直接连接服务。
DEVAGENTSTUDIO_TEMPLATE_ENGINE_BASE_URL=http://127.0.0.1:18080
DEVAGENTSTUDIO_TEMPLATE_ENGINE_CONNECT_TIMEOUT_SECONDS=10
DEVAGENTSTUDIO_TEMPLATE_ENGINE_READ_TIMEOUT_SECONDS=120

# 内置模拟数据库 SaaS；固定服务密钥仅由后端持有，与 SaaS 部署配置保持一致。
DEVAGENTSTUDIO_MANAGED_DATABASE_BASE_URL=http://127.0.0.1:18081
MANAGED_DATABASE_SERVICE_KEY=
DEVAGENTSTUDIO_MANAGED_DATABASE_TIMEOUT_SECONDS=15
DEVAGENTSTUDIO_TEMPLATE_PACKAGE_MAX_BYTES=104857600
DEVAGENTSTUDIO_TEMPLATE_PACKAGE_MAX_FILES=10000
DEVAGENTSTUDIO_TEMPLATE_PACKAGE_MAX_EXTRACTED_BYTES=524288000
# 是否开启模板能力二次注入
DEVAGENTSTUDIO_TEMPLATE_RECONCILE_ENABLED=true

# 版本发布 Git 凭证：生成新版本时 push 到 application.json 的 repoUrl 仓库。
# username 是仓库账号名；token 是 personal access token（需有 repo 写权限）。
DEVAGENTSTUDIO_GIT_USERNAME=
DEVAGENTSTUDIO_GIT_TOKEN=

# Embedded code-review-graph indexing. The foreground wait is bounded; after
# the timeout the workflow continues with file search while the index builds.
DEVAGENTSTUDIO_CODE_GRAPH_TIMEOUT_SECONDS=30

# Workflow checkpoint retention. Checkpoint DB defaults to:
# {workspace}/.devagentstudio/checkpoints/checkpoints.sqlite
DEVAGENTSTUDIO_CHECKPOINT_RETENTION_DAYS=30
# Optional override. If set, all workflow runs share this DB.
# DEVAGENTSTUDIO_CHECKPOINT_DB=/path/to/checkpoints.sqlite

# Durable Execution lease heartbeat and stale-owner detection.
# The lease TTL must be at least three heartbeat intervals.
XCODEAGENT_EXECUTION_RECOVERY_HEARTBEAT_SECONDS=10
XCODEAGENT_EXECUTION_RECOVERY_LEASE_TTL_SECONDS=45

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=devagentstudio-workflow
LANGSMITH_ENDPOINT=

# 后端埋点接收接口的完整 POST URL；留空时不发送埋点。
# 当前接口不发送鉴权信息；每次触发由专用埋点线程池发送一条记录，不自动重试。
DEVAGENTSTUDIO_TELEMETRY_URL=

# 数据库信息查询，默认不打开
DEVAGENTSTUDIO_ENDPOINT_DATABASE_CONTEXT_ENABLED=false

# 应用版本发布：Git 提交/打Tag/推送凭证（不入 git）
#
# 凭证来源开关（远端推送认证）：
#   env    = 读下面两个变量，拼成 https://用户名:令牌@主机/路径 交给 git。
#            公司外/默认使用。
#   helper = 不注入任何凭证，用仓库原始地址调用 git，认证交给本机 git 凭证助手
#            （Windows 凭据管理器 / macOS 钥匙串）。公司内使用 —— 员工本机用
#            SourceTree 或 git 命令行登录一次即可，仓库权限由 git 服务端按员工身份
#            校验，应用不接触凭证。此模式下下面两个变量可以留空。
#
# 拷贝到公司内部时把这一行改成 helper；公司外保持 env。
DEVAGENTSTUDIO_GIT_CREDENTIAL_SOURCE=env
DEVAGENTSTUDIO_GIT_USERNAME=ruyue1

# 提交身份（author name / email）。模板基线提交时写入工作区的仓库级配置。
#
# 公司内 Gitee 会校验提交的 author email，未授权会拒绝推送并报 git002
# "Unauthorized email account cannot submit code"。
#
# 留空时的取值顺序：本机全局 Git 身份（git config --get user.email）→ 占位身份。
# 公司机器上本机身份通常就是员工的公司邮箱（既然本机能用 SourceTree 推送，说明它被认可），
# 所以留空往往就能用；要明确指定就填这两项（必须同时填，只填一项会整体回落）。
# DEVAGENTSTUDIO_GIT_AUTHOR_NAME=ouruyue
# DEVAGENTSTUDIO_GIT_AUTHOR_EMAIL=ouruyue@cmbchina.com
DEVAGENTSTUDIO_GIT_TOKEN=
