{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcode-agent.local/schemas/antd-v4/component.schema.json",
  "title": "Ant Design v4 component description",
  "type": "object",
  "required": [
    "schemaVersion",
    "library",
    "libraryVersion",
    "name",
    "import",
    "category",
    "props",
    "events",
    "slots"
  ],
  "$defs": {
    "valueType": {
      "oneOf": [
        {
          "enum": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "enum",
            "node",
            "style",
            "any"
          ]
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "union",
                "array",
                "object",
                "tuple"
              ]
            },
            "types": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/valueType"
              }
            },
            "itemType": {
              "$ref": "#/$defs/valueType"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/valueType"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "editor": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "textarea",
            "number",
            "switch",
            "select",
            "multi-select",
            "node",
            "icon",
            "style",
            "json",
            "expression"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "placeholder": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "prop": {
      "type": "object",
      "required": [
        "name",
        "description",
        "valueType",
        "required",
        "bindable",
        "editor"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "valueType": {
          "$ref": "#/$defs/valueType"
        },
        "typescriptType": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "bindable": {
          "type": "boolean"
        },
        "defaultValue": true,
        "editor": {
          "$ref": "#/$defs/editor"
        },
        "slot": {
          "type": "string"
        },
        "since": {
          "type": "string"
        },
        "deprecated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "eventParameter": {
      "type": "object",
      "required": [
        "name",
        "typescriptType"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "typescriptType": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "extract": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "name",
        "description",
        "parameters",
        "actions"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventParameter"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "since": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "required": [
        "name",
        "description",
        "accepts",
        "multiple"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "accepts": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "icon",
              "component",
              "expression"
            ]
          }
        },
        "multiple": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": [
        "name",
        "description",
        "parameters",
        "returns"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventParameter"
          }
        },
        "returns": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "library": {
      "const": "antd"
    },
    "libraryVersion": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "import": {
      "type": "object",
      "required": [
        "package",
        "export"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "export": {
          "type": "string"
        },
        "subcomponent": {
          "type": "string"
        },
        "style": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "typeFile": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "props": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prop"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/method"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}

