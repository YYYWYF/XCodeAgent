{
  "id": "submitOrderButton",
  "component": "Button",
  "props": {
    "text": "提交订单",
    "type": "primary",
    "icon": "CheckOutlined",
    "loading": {
      "binding": "order.submitting"
    },
    "disabled": {
      "condition": {
        "field": "order.items.length",
        "operator": "equal",
        "value": 0
      }
    }
  },
  "events": {
    "click": [
      {
        "action": "submitForm",
        "formId": "orderForm"
      },
      {
        "action": "showMessage",
        "status": "success",
        "content": "订单提交成功"
      }
    ]
  }
}
