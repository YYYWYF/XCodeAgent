// v1 全字段 JSON 结构总览。没有 batch、record 等目录包装字段。
// 这是 JSONC（JSON 加注释）结构模板："string"、0、false、null 只显示类型/位置，不是业务示例值。
// 真正上传时删除注释、替换占位值，并按 telemetry-batch.schema.json 校验。
// records 是数组；每个元素是对象。下面展示 Trace 和业务事件的所有可用字段。
// 可选字段按 span_kind/event_name 选填；不适用则省略，不把所有字段同时上报。
// “可选”是全字段总览的标记；对应事件要求的字段仍按 Schema 必填。
{
  "schema_version": 1, // integer；固定合同版本 1
  "batch_id": "string", // string；上传批次 ID，重试复用
  "sent_at": "string", // string；实际发送时间，UTC RFC3339，Z 后缀
  "records": [
    {
      "record_id": "string", // string；必填；记录的稳定唯一 ID
      "type": "execution_trace", // string；必填；execution_trace/telemetry_event；只有两个采集来源类型
      "occurred_at": "string", // string；必填；该事实实际发生时间
      "producer": { // object；必填；所有记录都保留发生时的采集来源
        "source": "frontend", // string；必填；frontend/backend/worker；实际产生记录的进程类型
        "environment": "development", // string；必填；development/test/production；运行环境，避免开发与生产数据混算
        "platform": "macos", // string；必填；macos/windows/linux；操作系统，用于比较平台故障与性能
        "xcodeagent_version": "string" // string；必填；事实发生时的 Studio 产品版本，不能在上传时替换为当前版本
      },
      "identity": { // object；必填；当前事实的业务关联身份
        "user_id": "string", // string；必填；现有账号系统提供的稳定用户 ID
        "project_id": "string", // string；必填；本合同中代表应用的稳定身份，即 application.id
        "conversation_id": null, // string|null；必填；用户可见业务对话的稳定 ID，用于统计对话数
        "thread_id": null, // string|null；必填；实际执行使用的 LangGraph/AG-UI 线程 ID，可能与可见对话的线程不同
        "run_id": "string", // string；Trace 必填且不可为空；一次真实业务执行的 ID
        "operation_id": "string", // string；Trace 必填且不可为空；跨 Run 的业务操作 ID
        "change_id": null, // string|null；必填；所属 Formal Revision ID
        "workflow_scope": "string" // string；Trace 必填且不可为空；实际执行入口
      },
      "context": { // object；必填；用于场景、版本、节点及模式的对比分析
        "business_stage": null, // string|null；必填；稳定业务阶段，例如 requirements、ui_design、technical_planning、build、unit_test、acceptance
        "node_name": null, // string|null；必填；实际 Workflow Node 名称
        "execution_kind": null, // string|null；必填；initial/resume/revision/retry/regenerate/repair/null；本次执行业务原因
        "attempt": null, // integer|null；必填；本次具体业务生成请求的尝试序号，从 1 开始
        "mode": null, // string|null；必填；ultra/pro/fast/null；事实发生时实际选用的产品模式
        "target": { // object|null；必填；当前应用、页面、接口或实体目标
          "type": "application", // string；必填；application/page/endpoint/entity；开发或修改目标类型
          "id": "string", // string；必填；目标的稳定业务 ID
          "api_contract_id": null // string|null；必填；Endpoint 所属 API Contract ID
        },
        "extra": { // object；必填；只允许已登记的阶段补充字段
          "clarification_round": 0, // integer；按需；当前已发生的业务澄清轮次，从 0 开始
          "question_count": 0, // integer；按需；上一轮实际要求用户回答的问题数
          "retry_reason": "string", // string；按需；输出返回后发生业务重生成的真实原因
          "reference_template_id": null, // string|null；按需；开发目标实际选用的参考模板 ID，未使用时 null
          "has_element_context": false // boolean；按需；此次操作是否携带选定页面元素上下文
        }
      },
      "data": { // type=execution_trace 时的对象
        "trace_id": "string", // string；必填；整个技术调用树的稳定 ID，独立于业务 run_id
        "span_id": "string", // string；必填；当前模型、工具、Node 或 Workflow 执行片段的稳定 ID
        "parent_span_id": null, // string|null；必填；直接父 Span
        "span_kind": "model", // string；必填；workflow/node/model/tool；本平台的规范化类型 workflow/node/model/tool
        "run_name": "string", // string；必填；当前片段实际承担的职责
        "started_at": "string", // string；必填；执行开始时间
        "ended_at": null, // string|null；必填；执行结束时间
        "duration_ms": null, // integer|null；必填；当前 Span 端到端持续时间，优先单调时钟
        "status": "completed", // string；必填；completed/failed/cancelled/interrupted/awaiting_user；本平台规范化的执行终态
        "active_intervals": [{ // array<object>|null；可选，仅 workflow 根 Span 必填；扣除用户等待的执行区间
          "started_at": "string", // string；必填；该执行区间开始时间，UTC
          "ended_at": "string", // string；必填；该执行区间结束时间，UTC
          "duration_ms": 0 // integer；必填；实际执行毫秒数；[] 表示已知没有执行，null 表示未知
        }],
        "model": { // object；可选，仅 span_kind=model 时必填，其他类型不传
          "provider": "string", // string；必填；实际调用的 Provider 或网关标识，不含地址、凭证
          "name": "string", // string；必填；实际发送请求的模型标识
          "input_tokens": null, // integer|null；必填；实际输入 Token
          "output_tokens": null, // integer|null；必填；实际输出 Token
          "total_tokens": null, // integer|null；必填；输入与输出 Token 之和
          "usage_source": "unavailable", // string；必填；provider/estimated/unavailable；Token 数据来源：模型返回/显式估算/未获得
          "usage_status": "unavailable", // string；必填；complete/partial/unavailable；完整/部分已知/全部未知
          "ttft_ms": null, // integer|null；必填；当前逻辑模型调用开始到首个非空生成输出的时间
          "output_duration_ms": null // integer|null；必填；流式首个非空输出到最后一个非空输出的实际间隔，采集器用单调时钟测量
        },
        "error": { // object|null；必填；实际技术异常
          "layer": "model", // string；必填；model/tool/validation/transport/system；错误所属层：model/tool/validation/transport/system
          "code": null, // string|null；必填；已有稳定错误码，无法确定时为 null，不从错误文案猜测
          "message": "string" // string；必填；实际错误信息的脱敏摘要
        },
        "result": { // object；按需；真实业务结果摘要，可用于模型输出校验或 Node/Workflow 结果
          "outcome": "succeeded", // string；必填；succeeded/failed/blocked/awaiting_user/cancelled/skipped；已确认的业务结果
          "first_attempt_passed": null, // boolean|null；按需；该业务操作在当前 node/阶段的首轮校验、Build 或测试是否通过
          "repair_rounds": 0, // integer；按需；已发生的业务修复轮数，不含网络重试
          "test_summary": { // object|null；按需；单元/集成测试统计，不适用时为空
            "passed": 0, // integer；必填；通过的真实测试/检查数
            "failed": 0, // integer；必填；失败的真实测试/检查数
            "skipped": 0 // integer；必填；明确跳过的真实测试/检查数
          },
          "review_issue_counts": null, // object|null；按需；代码审查问题数量，按严重程度分类
          "quality_gate_passed": null, // boolean|null；按需；当前最终质量门禁是否通过
          "acceptance_decision": null, // string|null；按需；accepted/rejected/revision_requested/null；用户实际验收决定
          "cache_hit": null, // boolean|null；按需；Workspace Inspection 是否命中缓存
          "code_graph_status": null, // string|null；按需；available/degraded/unavailable/null；Code Graph 可用性
          "unit_reuse_count": null, // integer|null；按需；DAG 规划复用的 Unit 数
          "unit_generation_count": null, // integer|null；按需；DAG 规划需要生成的 Unit 数
          "task_count": null, // integer|null；按需；本次确定的 Task 数量
          "capability_escalated": null // boolean|null；按需；SmallTask 实际是否升级到更大的处理能力
        }
      }
    },
    {
      "record_id": "string", // string；必填；记录的稳定唯一 ID
      "type": "telemetry_event", // string；必填；execution_trace/telemetry_event；只有两个采集来源类型
      "occurred_at": "string", // string；必填；该事实实际发生时间
      "producer": { // object；必填；所有记录都保留发生时的采集来源
        "source": "frontend", // string；必填；frontend/backend/worker；实际产生记录的进程类型
        "environment": "development", // string；必填；development/test/production；运行环境，避免开发与生产数据混算
        "platform": "macos", // string；必填；macos/windows/linux；操作系统，用于比较平台故障与性能
        "xcodeagent_version": "string" // string；必填；事实发生时的 Studio 产品版本，不能在上传时替换为当前版本
      },
      "identity": { // object；必填；当前事实的业务关联身份
        "user_id": "string", // string；必填；现有账号系统提供的稳定用户 ID
        "project_id": "string", // string；必填；本合同中代表应用的稳定身份，即 application.id
        "conversation_id": null, // string|null；必填；用户可见业务对话的稳定 ID，用于统计对话数
        "thread_id": null, // string|null；必填；实际执行使用的 LangGraph/AG-UI 线程 ID，可能与可见对话的线程不同
        "run_id": null, // string|null；必填；一次真实业务执行的 ID
        "operation_id": null, // string|null；必填；平台为一次独立业务操作分配的观测关联 ID
        "change_id": null, // string|null；必填；所属 Formal Revision ID
        "workflow_scope": null // string|null；必填；实际执行入口，例如 application_planning、conversation、workbench、ui_generation
      },
      "context": { // object；必填；用于场景、版本、节点及模式的对比分析
        "business_stage": null, // string|null；必填；稳定业务阶段，例如 requirements、ui_design、technical_planning、build、unit_test、acceptance
        "node_name": null, // string|null；必填；实际 Workflow Node 名称
        "execution_kind": null, // string|null；必填；initial/resume/revision/retry/regenerate/repair/null；本次执行业务原因
        "attempt": null, // integer|null；必填；本次具体业务生成请求的尝试序号，从 1 开始
        "mode": null, // string|null；必填；ultra/pro/fast/null；事实发生时实际选用的产品模式
        "target": { // object|null；必填；当前应用、页面、接口或实体目标
          "type": "application", // string；必填；application/page/endpoint/entity；开发或修改目标类型
          "id": "string", // string；必填；目标的稳定业务 ID
          "api_contract_id": null // string|null；必填；Endpoint 所属 API Contract ID
        },
        "extra": { // object；必填；只允许已登记的阶段补充字段
          "clarification_round": 0, // integer；按需；当前已发生的业务澄清轮次，从 0 开始
          "question_count": 0, // integer；按需；上一轮实际要求用户回答的问题数
          "retry_reason": "string", // string；按需；输出返回后发生业务重生成的真实原因
          "reference_template_id": null, // string|null；按需；开发目标实际选用的参考模板 ID，未使用时 null
          "has_element_context": false // boolean；按需；此次操作是否携带选定页面元素上下文
        }
      },
      "data": { // type=telemetry_event 时的对象
        "event_name": "string", // string；必填；application_created/conversation_created/user_turn_submitted/development_target_started/request_classified/requirement_document_ready/artifact_reviewed/ui_design_action_accepted/revision_impact_decided/control_action_accepted/development_artifact_completed/application_version_created/code_generated/code_written/code_committed/workflow_failure/thread_handoff/execution_thread_continued/application_profile_updated
        "event_category": "business", // business/failure/handoff；分类由事件确定
        "payload": { // object；必填；以下是所有事件字段的并集，按 event_name 选填
          "creation_source": "string", // string；可选，按事件填写；创建来源；应用创建使用 new_app，对话创建使用 automatic/user；适用：application_created/conversation_created；取值：new_app/automatic/user
          "turn_kind": "string", // string；可选，按事件填写；用户实际提交的本轮输入类型，允许按口径筛选活跃用户；适用：user_turn_submitted；取值：request/clarification_answer/confirmation/feedback
          "input_modalities": ["string"], // array；可选，按事件填写；仅记录文本/图片类型，不上传输入正文、截图或图片内容；适用：user_turn_submitted；元素取值：text/image
          "image_count": 0, // integer；可选，按事件填写；本轮提交的图片数量；适用：user_turn_submitted
          "has_element_context": false, // boolean；可选，按事件填写；是否提供已选页面元素上下文；不上传 DOM 或源码；适用：user_turn_submitted
          "request_kind": "string", // string；可选，按事件填写；实际已确定的请求分类，例如 casual_chat、workspace_question、implementation_fix、formal_revision；适用：request_classified
          "route_stage": "string", // string；可选，按事件填写；最终已确定的目标业务阶段；确定性路由同样记录；适用：request_classified
          "document_id": "string", // string；可选，按事件填写；RequirementSpec 与 ProductPlan 联合需求文档的稳定 ID；适用：requirement_document_ready
          "artifact_revision": 0, // integer；可选，按事件填写；本次交付用户评价的文档版本；适用：requirement_document_ready/artifact_reviewed
          "clarification_round": 0, // integer；可选，按事件填写；形成该版本时已完成的澄清轮数；适用：requirement_document_ready
          "artifact_id": "string", // string；可选，按事件填写；用户正在评价的正式候选产物或联合需求文档 ID；适用：artifact_reviewed
          "artifact_type": "string", // string；可选，按事件填写；被评价的业务产物类型；适用：artifact_reviewed；取值：requirement_document/ui_design/technical_plan/build_task_plan
          "decision": "string", // string；可选，按事件填写；系统实际接受的用户决定；不记录无效或过期按钮点击；适用：artifact_reviewed/revision_impact_decided；取值：accept/revise/regenerate/skip/approved/rejected
          "user_edited": false, // boolean；可选，按事件填写；确认时是否发现并同步用户对 Markdown/候选内容的实际修改；适用：artifact_reviewed
          "action": "string", // string；可选，按事件填写；实际接受的 UI 设计或执行控制操作；适用：ui_design_action_accepted/control_action_accepted；取值：select_template/regenerate/adjust_pages/skip/stop/pause/retry/resume
          "page_ids": ["string"], // array；可选，按事件填写；本次操作涉及的页面；适用：ui_design_action_accepted
          "template_id": null, // string|null；可选，按事件填写；选用的参考模板 ID；未选模板时为空；适用：ui_design_action_accepted
          "affected_artifacts": ["string"], // array；可选，按事件填写；后端最终确认的受影响产物集合；适用：revision_impact_decided；元素取值：requirement_spec/product_plan/ui_design/technical_plan
          "earliest_stage": "string", // string；可选，按事件填写；当前影响分析最终确定的最早回退阶段；适用：revision_impact_decided
          "action_id": "string", // string；可选，按事件填写；实际已接受的控制动作 ID，避免重复回调重复计数；适用：control_action_accepted
          "target_run_id": "string", // string；可选，按事件填写；被控制的原执行 ID；适用：control_action_accepted
          "target_node_name": null, // string|null；可选，按事件填写；原系统签发的目标 Node 名称；不适用时为空；适用：control_action_accepted
          "child_run_id": null, // string|null；可选，按事件填写；实际创建的新执行 ID；没有创建新执行时为空；适用：control_action_accepted
          "repo_id": "string", // string；可选，按事件填写；目标仓库稳定标识，不上传含凭证的 URL；适用：application_version_created/code_committed
          "branch_name": "string", // string；可选，按事件填写；本次版本或代码提交对应的 Git 分支；适用：application_version_created/code_committed
          "commit_sha": "string", // string；可选，按事件填写；真实 Git SHA；版本事件取成功推送 SHA，代码统计关联提交但不据此重定义入库；适用：application_version_created/code_committed
          "completed_artifacts": { // object；可选，按事件填写；保存不可变版本快照，防止后续规划变化覆盖已发布版本的统计；适用：application_version_created
            "page_ids": ["string"], // array；所属对象填写时必填；本次版本成功生成时实际已完成开发的页面清单；不含仅规划的页面
            "endpoints": [{ // array；所属对象填写时必填；本次版本成功生成时实际已完成开发的接口清单；接口以 Contract 与 Endpoint 联合标识
              "api_contract_id": "string", // string；所属对象填写时必填；Endpoint 所属 API Contract ID
              "endpoint_id": "string" // string；所属对象填写时必填；已完成开发的 Endpoint ID
            }]
          },
          "model_span_id": "string", // string；可选，按事件填写；对应的真实 Model Span ID；适用：code_generated
          "generated_lines": null, // integer|null；可选，按事件填写；现有计量方法得到的 LLM 生成代码行数；适用：code_generated
          "measurement_method": "string", // string；可选，按事件填写；已有代码计量/归因方法的标识，便于判断是否可比较；适用：code_generated/code_written/code_committed
          "model_span_ids": ["string"], // array；可选，按事件填写；已识别的来源模型 Span ID，未识别为 []；不为了填充而猜测来源；适用：code_written
          "written_lines": null, // integer|null；可选，按事件填写；实际写入文件的 LLM 代码行数，沿用已有计量方法；适用：code_written
          "parent_commit_sha": null, // string|null；可选，按事件填写；提交前基线 SHA，用于应用既有入库行数/归因算法；适用：code_committed
          "committed_lines": null, // integer|null；可选，按事件填写；用户已有算法提供的入库代码行数结果；计量时机、周期、累计或增量含义沿用既有方法；适用：code_committed
          "repository_code_lines": null, // integer|null；可选，按事件填写；用户已有算法提供的仓库代码行数依据；方法未提供时 null，不在本方案预设统计范围；适用：code_committed
          "studio_code_lines": null, // integer|null；可选，按事件填写；用户已有算法提供的 Studio 代码行数依据；方法未提供时 null，不在本方案预设来源划分；适用：code_committed
          "code_inclusion_rate": null, // number|null；可选，按事件填写；用户已有算法提供的比例结果，以 0~1 编码上传；本方案不重算分子分母；适用：code_committed
          "scope": "string", // string；可选，按事件填写；失败终态的业务范围，用 operation_id 或 run_id 聚合；适用：workflow_failure；取值：operation/workflow
          "failed_span_id": null, // string|null；可选，按事件填写；对应失败 Span ID；Trace 未覆盖的故障允许为空；适用：workflow_failure
          "recoverable": false, // boolean；可选，按事件填写；现有系统是否提供恢复条件；仅观测，不决定恢复；适用：workflow_failure
          "error": { // object；可选，按事件填写；Trace 异常及业务失败诊断共享的错误结构；适用：workflow_failure
            "layer": "string", // string；所属对象填写时必填；错误所属层：model/tool/validation/transport/system；由已知异常或业务结果确定；取值：model/tool/validation/transport/system
            "code": null, // string|null；所属对象填写时必填；已有稳定错误码，无法确定时为 null，不从错误文案猜测
            "message": "string" // string；所属对象填写时必填；实际错误信息的脱敏摘要；不上传凭证、完整 Prompt 或源码
          },
          "to_conversation_id": "string", // string；可选，按事件填写；真实业务交接后的可见对话 ID；来源为公共 identity.conversation_id；适用：thread_handoff
          "to_thread_id": "string", // string；可选，按事件填写；业务交接或技术续接后的实际执行线程 ID；适用：thread_handoff/execution_thread_continued
          "to_business_stage": "string", // string；可选，按事件填写；交接后的业务阶段；适用：thread_handoff
          "reason": "string", // string；可选，按事件填写；实际业务交接原因；上下文超限技术续接固定 context_limit；适用：thread_handoff/execution_thread_continued
          "to_run_id": "string", // string；可选，按事件填写；实际启动的续接 Run ID；适用：execution_thread_continued
          "scenario_code": null, // string|null；可选，按事件填写；已确认业务文档中可确定的场景分类；尚未有分类规则/结果时 null，不临时新增模型调用生成画像；适用：application_profile_updated
          "scenario_tags": ["string"], // array；可选，按事件填写；已有已确认文档能提供的业务场景标签；没有标签为 []，不上传需求全文；适用：application_profile_updated
          "terminal": null, // string|null；可选，按事件填写；已确认产物或应用权威配置中的终端类型；没有明确值为 null；适用：application_profile_updated
          "datasource_type": null, // string|null；可选，按事件填写；application.json 或已确认的数据源配置中的类型；不上传地址或凭证，不确定为 null；适用：application_profile_updated
          "auth_enabled": null, // boolean|null；可选，按事件填写；应用权威配置中的认证开关，不是 Studio 用户登录情况；适用：application_profile_updated
          "authorization_enabled": null, // boolean|null；可选，按事件填写；应用权威配置中的授权/RBAC 开关；适用：application_profile_updated
          "source_artifact_id": "string" // string；可选，按事件填写；画像依据的已确认正式产物 ID；适用：application_profile_updated
        }
      }
    }
  ]
}
