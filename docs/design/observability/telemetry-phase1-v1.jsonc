// 一期精简字段结构：领导报表、Agent 调用成本、基础故障定位。
// 这是 JSONC 结构说明；"string"、0、false、null 是占位值，不是真实上报数据。
// records 是数组，下面分别展示 Trace 与业务事件；真实记录按 type 二选一。
// payload 展示一期全部事件字段的并集；实际只传当前事件适用的字段。
// 本文件是独立的一期范围；telemetry-batch.schema.json 是完整版，不能直接用于校验本文件的精简记录。
// 后续增加的字段应设为可选；保持一期字段的名称、含义、单位与必填规则。
{
  "schema_version": 1, // integer；必填；上传结构版本，不是产品版本
  "batch_id": "string", // string；必填；上传批次 ID，同批重试复用；记录去重仍使用 record_id
  "sent_at": "string", // string；必填；本次发送时间，UTC RFC3339，Z 后缀
  "records": [
    {
      "record_id": "string", // string；必填；事实记录的稳定唯一 ID，重试保持不变
      "type": "execution_trace", // string；必填；当前记录为执行 Trace
      "occurred_at": "string", // string；必填；执行终态记录形成时间，UTC；不使用上传时间代替
      "producer": {
        "source": "backend", // string；必填；frontend/backend/worker，实际产生记录的进程
        "environment": "development", // string；必填；development/test/production
        "platform": "macos", // string；必填；macos/windows/linux，采集进程运行的操作系统
        "xcodeagent_version": "string" // string；必填；执行发生时的 Studio 产品版本
      },
      "identity": {
        "user_id": "string", // string；必填；现有账号系统的稳定用户 ID
        "project_id": "string", // string；必填；应用的稳定身份 application.id，不随线程、分支或重开改变
        "conversation_id": null, // string|null；必填；所属用户可见对话 ID，无所属对话时 null
        "thread_id": null, // string|null；必填；实际执行线程 ID，无实际线程时 null；不拿它统计对话数
        "run_id": "string", // string；必填；本次业务执行 ID，不是 LangSmith Span ID
        "operation_id": "string", // string；必填；跨澄清、确认、恢复等多个 Run 保持一致的业务操作 ID
        "workflow_scope": "string" // string；必填；实际执行入口，例如 application_planning、conversation
      },
      "context": {
        "business_stage": null, // string|null；必填；业务阶段，如 requirements/build/unit_test；不适用时 null
        "node_name": null, // string|null；必填；实际 Workflow Node 名称；不适用时 null
        "mode": null, // string|null；必填；ultra/pro/fast，实际选择的产品模式；未知或未启用时 null
        "target": { // object|null；必填；当前开发目标，没有明确目标时整个对象为 null
          "type": "application", // string；对象非空时必填；application/page/endpoint/entity
          "id": "string", // string；对象非空时必填；目标稳定 ID
          "api_contract_id": null // string|null；对象非空时必填；endpoint 必须有值，其他目标为 null
        }
      },
      "data": {
        "trace_id": "string", // string；必填；整棵调用树的 ID；根 Span 的 trace_id 等于 span_id
        "span_id": "string", // string；必填；当前执行片段的稳定 ID，模型用量按此去重
        "parent_span_id": null, // string|null；必填；直接父 Span；根为 null，过滤包装后指向最近保留祖先
        "span_kind": "model", // string；必填；workflow/node/model/tool，本平台执行片段分类
        "run_name": "string", // string；必填；调用职责、工具名或实际节点名
        "started_at": "string", // string；必填；真实执行开始时间，UTC；用于事后 QPS
        "ended_at": null, // string|null；必填；真实执行结束时间，UTC；异常中断无法确定时 null
        "duration_ms": null, // integer|null；必填；执行耗时，毫秒，优先单调时钟；未知为 null
        "status": "completed", // string；必填；completed/failed/cancelled/interrupted/awaiting_user，技术执行状态
        "active_intervals": [{ // array<object>|null；仅 workflow 根 Span 必填，其他类型省略
          "started_at": "string", // string；必填；有效执行区间开始时间，UTC
          "ended_at": "string", // string；必填；有效执行区间结束时间，UTC
          "duration_ms": 0 // integer；必填；该区间实际执行毫秒数，不含等用户、暂停及未执行的排队时间
        }], // [] 表示确知无执行，null 表示未知；使用时长按用户/对话/应用合并重叠区间，不叠加父子或并行耗时
        "model": { // object；仅 span_kind=model 时必填，其他类型省略
          "provider": "string", // string；必填；实际模型供应方或网关标识，不含地址和凭证
          "name": "string", // string；必填；实际请求的模型标识
          "input_tokens": null, // integer|null；必填；输入 Token，未知为 null，不能填 0 冒充
          "output_tokens": null, // integer|null；必填；输出 Token，未知为 null
          "total_tokens": null, // integer|null；必填；总 Token，完整时等于输入加输出
          "usage_source": "unavailable", // string；必填；provider/estimated/unavailable，实际返回/显式估算/未取得
          "usage_status": "unavailable", // string；必填；complete/partial/unavailable，全部已知/部分已知/全部未知
          "ttft_ms": null, // integer|null；必填；调用开始到首个非空生成输出的毫秒数；非流式或未观测时 null
          "output_duration_ms": null // integer|null；必填；首个到最后一个非空流式输出的间隔；未观测或无有效间隔时 null
        },
        "error": { // object|null；必填；实际技术异常，无异常时整个对象为 null
          "layer": "model", // string；对象非空时必填；model/tool/validation/transport/system
          "code": null, // string|null；对象非空时必填；已有稳定错误码，无法确定时 null
          "message": "string" // string；对象非空时必填；脱敏错误摘要，不上传凭证、完整 Prompt 或源码
        }
      }
    },
    {
      "record_id": "string", // string；必填；同一业务事实的记录 ID 保持不变，不因重传重新生成
      "type": "telemetry_event", // string；必填；当前记录为业务事实事件
      "occurred_at": "string", // string；必填；业务事实实际发生时间，UTC RFC3339，Z 后缀
      "producer": {
        "source": "frontend", // string；必填；frontend/backend/worker
        "environment": "development", // string；必填；development/test/production
        "platform": "macos", // string；必填；macos/windows/linux
        "xcodeagent_version": "string" // string；必填；事实发生时的 Studio 产品版本
      },
      "identity": {
        "user_id": "string", // string；必填；现有账号系统的稳定用户 ID
        "project_id": "string", // string；必填；应用的稳定身份 application.id
        "conversation_id": null, // string|null；必填；对话创建、用户提交事件必须有值；其他无所属对话时 null
        "thread_id": null, // string|null；必填；实际执行线程 ID；未发生执行时可为 null
        "run_id": null, // string|null；必填；所属业务执行 ID；未发生执行时可为 null
        "operation_id": null, // string|null；必填；开发完成、最终失败事件必须有值；无所属操作时 null
        "workflow_scope": null // string|null；必填；实际执行入口；无执行上下文时 null
      },
      "context": {
        "business_stage": null, // string|null；必填；事实所属业务阶段，无上下文时 null
        "node_name": null, // string|null；必填；事实所属节点，无上下文时 null
        "mode": null, // string|null；必填；ultra/pro/fast，无模式上下文时 null
        "target": { // object|null；必填；开发完成事件必须有目标，其他无明确目标时整个对象为 null
          "type": "page", // string；对象非空时必填；application/page/endpoint/entity
          "id": "string", // string；对象非空时必填；页面/API 按稳定目标身份累计去重
          "api_contract_id": null // string|null；对象非空时必填；endpoint 必须有值，其他目标为 null
        }
      },
      "data": {
        "event_name": "string", // string；必填；application_created/conversation_created/user_turn_submitted/development_artifact_completed/application_version_created/code_generated/code_written/code_committed/workflow_failure
        "payload": { // object；必填；以下字段按 event_name 选填；开发完成事件传 {}，目标放在 context.target
          "creation_source": "string", // string；应用/对话创建事件必填；应用固定 new_app，对话为 automatic/user；打开或导入旧应用不发新建事件
          "turn_kind": "string", // string；user_turn_submitted 必填；request/clarification_answer/confirmation/feedback
          "repo_id": "string", // string；版本创建、代码入库事件必填；稳定仓库标识，不上传含凭证的 URL
          "commit_sha": "string", // string；版本创建、代码入库事件必填；真实提交 SHA；版本事件只在提交并推送成功后记录，相同 SHA 重推不新增版本
          "generated_lines": null, // integer|null；code_generated 必填；既有方法测得的生成代码行数，未知为 null
          "written_lines": null, // integer|null；code_written 必填；既有方法测得的实际写入代码行数，未知为 null
          "committed_lines": null, // integer|null；code_committed 必填；你的已有算法提供的入库行数，不在本合同重定义入库算法
          "measurement_method": "string", // string；三个代码事件必填；既有计量方法及统计范围的标识，周期汇总沿用该方法
          "code_inclusion_rate": null, // number|null；code_committed 必填；已有算法输出，按 0~1 编码；未知为 null，不重算分子分母
          "scope": "string", // string；workflow_failure 必填；operation/workflow，最终业务失败所属范围
          "failed_span_id": null, // string|null；workflow_failure 必填；实际失败 Span ID，Trace 未覆盖时 null
          "error": { // object；workflow_failure 必填；仅记录最终业务失败；自动恢复的瞬时异常保留在 Trace
            "layer": "validation", // string；必填；model/tool/validation/transport/system
            "code": null, // string|null；必填；已有稳定错误码，无法确定时 null
            "message": "string" // string；必填；最终失败的脱敏摘要
          }
        }
      }
    }
  ]
}
