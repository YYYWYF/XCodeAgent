# 首期固定 direct；gateway 实现完成，但必须补齐真实网关参数后再切换。
MODEL_UPSTREAM=direct
SERVICE_TOKEN=local-model-transmit-dev-token
DIRECT_BASE_URL=http://open-llm.uat.cmbchina.cn/llm/deepseek-v4p1-flash-w8a8/v1
DIRECT_MODEL_NAME=deepseek-v4p1-flash-w8a8
DIRECT_API_KEY=replace-with-direct-api-key
# gateway 档位由服务端统一选择，支持 fast / pro / ultra；修改后重启服务。
GATEWAY_TIER=fast
GATEWAY_FAST_BASE_URL=http://lt5404-agent-gateway.paas.cmbchina.cn/pattern/llm/fast/v1
GATEWAY_FAST_MODEL_NAME=fast
# 以下地址和请求体 model 标识需按真实网关接口填写，不能直接推测。
GATEWAY_PRO_BASE_URL=
GATEWAY_PRO_MODEL_NAME=
GATEWAY_ULTRA_BASE_URL=
GATEWAY_ULTRA_MODEL_NAME=
# 三档共用认证参数与身份请求头规则。
GATEWAY_API_KEY=
GATEWAY_KEY=
# request 表示由 metadata.spaid 传入；fixed 表示始终采用下面的固定值。
GATEWAY_SPAID_SOURCE=request
GATEWAY_SPAID=
UPSTREAM_TRUST_ENV=false
DEFAULT_TIMEOUT_SECONDS=300
MAX_TIMEOUT_SECONDS=1800
MAX_RETRIES=2
MAX_REQUEST_BYTES=16777216
# 默认 data/model_history.sqlite3，可配置绝对路径。
# HISTORY_DB_PATH=F:/Code/code7.1_model_transmit/data/model_history.sqlite3
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=devagent-model-transmit
MOCK_ANALYTICS_ENABLED=false
