{
  "name": "LT54.06_XCODE_AGENT_FRONTEND_APP",
  "version": "1.0.0",
  "description": "XcodeAgent(生成低开应用)",
  "main": "./out/main/index.js",
  "author": "80303865",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "electron-vite preview",
    "dev": "cross-env APP_ENV=dev electron-vite dev",
    "dev:st": "cross-env APP_ENV=st electron-vite dev",
    "dev:uat": "cross-env APP_ENV=uat electron-vite dev",
    "dev:prd": "cross-env APP_ENV=prd electron-vite dev",
    "build": "pnpm build:dev",
    "build:dev": "pnpm typecheck && cross-env APP_ENV=dev electron-vite build",
    "build:st": "pnpm typecheck && cross-env APP_ENV=st electron-vite build",
    "build:uat": "pnpm typecheck && cross-env APP_ENV=uat electron-vite build",
    "build:prd": "pnpm typecheck && cross-env APP_ENV=prd electron-vite build",
    "verify:backend-resource": "node scripts/verify-backend-resource.mjs",
    "verify:backend-resource:win": "node scripts/verify-backend-resource.mjs --platform=win32",
    "verify:backend-resource:mac": "node scripts/verify-backend-resource.mjs --platform=darwin",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win:dev": "pnpm verify:backend-resource:win && pnpm build:dev && electron-builder --win --x64",
    "build:win:st": "pnpm verify:backend-resource:win && pnpm build:st && electron-builder --win --x64",
    "build:win:uat": "pnpm verify:backend-resource:win && pnpm build:uat && electron-builder --win --x64",
    "build:win:prd": "pnpm verify:backend-resource:win && pnpm build:prd && electron-builder --win --x64",
    "build:mac": "pnpm build:mac:dev",
    "build:mac:dev": "pnpm verify:backend-resource:mac && pnpm build:dev && electron-builder --mac",
    "build:mac:st": "pnpm verify:backend-resource:mac && pnpm build:st && electron-builder --mac",
    "build:mac:uat": "pnpm verify:backend-resource:mac && pnpm build:uat && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ant-design/icons": "^5.0.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@rollup/rollup-win32-x64-msvc": "^4.61.0",
    "antd": "^4.24.8",
    "axios": "^1.3.6",
    "clsx": "^2.1.1",
    "compressing": "^1.10.3",
    "electron-updater": "^6.3.9",
    "fs-extra": "^11.3.5",
    "lodash": "^4.17.21",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router": "^6.8.2",
    "react-router-dom": "^6.8.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.16.5",
    "@types/react": "^18.0.25",
    "@types/react-dom": "^18.0.9",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "less": "^4.6.4",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@8.15.9"
}
