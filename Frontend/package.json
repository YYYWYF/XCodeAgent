{
  "name": "xcode-agent-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "XCode Agent",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "20.19.0"
