{
  "$schema": "../schema/component.schema.json",
  "schemaVersion": "0.1.0",
  "library": "antd",
  "libraryVersion": "4.24.16",
  "name": "Input",
  "displayName": "输入框",
  "description": "通过鼠标或键盘输入内容，是最基础的表单域包装。",
  "category": "data-entry",
  "import": {
    "package": "antd",
    "export": "Input",
    "style": "antd/es/input/style"
  },
  "source": {
    "typeFile": "node_modules/antd/es/input/Input.d.ts",
    "documentation": "https://4x.ant.design/components/input/"
  },
  "extends": [
    "html.input.attributes",
    "aria.attributes",
    "data.attributes"
  ],
  "props": [
    {
      "name": "value",
      "description": "输入框内容，设置后组件进入受控模式。",
      "valueType": {
        "kind": "union",
        "types": [
          "string",
          "number"
        ]
      },
      "typescriptType": "string | number | readonly string[]",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "expression"
      }
    },
    {
      "name": "defaultValue",
      "description": "输入框默认内容，仅用于非受控模式。",
      "valueType": {
        "kind": "union",
        "types": [
          "string",
          "number"
        ]
      },
      "typescriptType": "string | number | readonly string[]",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "text"
      }
    },
    {
      "name": "placeholder",
      "description": "输入提示文本。",
      "valueType": "string",
      "typescriptType": "string",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "text"
      }
    },
    {
      "name": "type",
      "description": "原生 input 类型。",
      "valueType": "string",
      "typescriptType": "React.HTMLInputTypeAttribute | string",
      "required": false,
      "bindable": true,
      "defaultValue": "text",
      "editor": {
        "type": "select",
        "options": [
          "text",
          "email",
          "number",
          "password",
          "search",
          "tel",
          "url",
          "date",
          "time"
        ]
      }
    },
    {
      "name": "size",
      "description": "输入框大小。",
      "valueType": "enum",
      "typescriptType": "'small' | 'middle' | 'large'",
      "required": false,
      "bindable": true,
      "defaultValue": "middle",
      "editor": {
        "type": "select",
        "options": [
          "small",
          "middle",
          "large"
        ]
      }
    },
    {
      "name": "status",
      "description": "设置校验状态。",
      "valueType": "enum",
      "typescriptType": "'warning' | 'error' | ''",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "select",
        "options": [
          "",
          "warning",
          "error"
        ]
      },
      "since": "4.19.0"
    },
    {
      "name": "disabled",
      "description": "是否禁用输入框。",
      "valueType": "boolean",
      "typescriptType": "boolean",
      "required": false,
      "bindable": true,
      "defaultValue": false,
      "editor": {
        "type": "switch"
      }
    },
    {
      "name": "readOnly",
      "description": "是否只读。",
      "valueType": "boolean",
      "typescriptType": "boolean",
      "required": false,
      "bindable": true,
      "defaultValue": false,
      "editor": {
        "type": "switch"
      }
    },
    {
      "name": "bordered",
      "description": "是否显示边框。",
      "valueType": "boolean",
      "typescriptType": "boolean",
      "required": false,
      "bindable": true,
      "defaultValue": true,
      "editor": {
        "type": "switch"
      },
      "since": "4.5.0"
    },
    {
      "name": "allowClear",
      "description": "允许清除内容，可自定义清除图标。",
      "valueType": {
        "kind": "union",
        "types": [
          "boolean",
          {
            "kind": "object",
            "fields": {
              "clearIcon": "node"
            }
          }
        ]
      },
      "typescriptType": "boolean | { clearIcon?: React.ReactNode }",
      "required": false,
      "bindable": true,
      "defaultValue": false,
      "editor": {
        "type": "json"
      }
    },
    {
      "name": "maxLength",
      "description": "最大输入长度。",
      "valueType": "number",
      "typescriptType": "number",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "number"
      }
    },
    {
      "name": "showCount",
      "description": "是否展示字数统计；格式化函数由运行时注册表引用，不能直接写入 JSON。",
      "valueType": {
        "kind": "union",
        "types": [
          "boolean",
          {
            "kind": "object",
            "fields": {
              "formatter": "string"
            }
          }
        ]
      },
      "typescriptType": "boolean | { formatter: RuntimeFunctionRef }",
      "required": false,
      "bindable": true,
      "defaultValue": false,
      "editor": {
        "type": "json"
      },
      "since": "4.18.0"
    },
    {
      "name": "htmlSize",
      "description": "原生 input 元素的 size 属性。",
      "valueType": "number",
      "typescriptType": "number",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "number"
      }
    },
    {
      "name": "autoComplete",
      "description": "浏览器自动填充策略。",
      "valueType": "string",
      "typescriptType": "string",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "text"
      }
    },
    {
      "name": "prefix",
      "description": "输入框前缀节点。",
      "valueType": "node",
      "typescriptType": "React.ReactNode",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "node"
      },
      "slot": "prefix"
    },
    {
      "name": "suffix",
      "description": "输入框后缀节点。",
      "valueType": "node",
      "typescriptType": "React.ReactNode",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "node"
      },
      "slot": "suffix"
    },
    {
      "name": "addonBefore",
      "description": "输入框前置标签节点。",
      "valueType": "node",
      "typescriptType": "React.ReactNode",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "node"
      },
      "slot": "addonBefore"
    },
    {
      "name": "addonAfter",
      "description": "输入框后置标签节点。",
      "valueType": "node",
      "typescriptType": "React.ReactNode",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "node"
      },
      "slot": "addonAfter"
    },
    {
      "name": "className",
      "description": "附加 CSS 类名。",
      "valueType": "string",
      "typescriptType": "string",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "text"
      }
    },
    {
      "name": "style",
      "description": "内联样式对象。",
      "valueType": "style",
      "typescriptType": "React.CSSProperties",
      "required": false,
      "bindable": true,
      "editor": {
        "type": "style"
      }
    }
  ],
  "events": [
    {
      "name": "onChange",
      "description": "输入值变化时触发。",
      "parameters": [
        {
          "name": "event",
          "typescriptType": "React.ChangeEvent<HTMLInputElement>",
          "extract": {
            "value": "target.value",
            "name": "target.name",
            "type": "target.type",
            "checked": "target.checked"
          }
        }
      ],
      "actions": [
        "state.set",
        "form.setFieldValue",
        "service.call"
      ]
    },
    {
      "name": "onPressEnter",
      "description": "按下回车键时触发。",
      "parameters": [
        {
          "name": "event",
          "typescriptType": "React.KeyboardEvent<HTMLInputElement>",
          "extract": {
            "value": "currentTarget.value",
            "key": "key",
            "ctrlKey": "ctrlKey",
            "metaKey": "metaKey",
            "shiftKey": "shiftKey"
          }
        }
      ],
      "actions": [
        "state.set",
        "form.submit",
        "service.call"
      ]
    },
    {
      "name": "onFocus",
      "description": "输入框获得焦点时触发。",
      "parameters": [
        {
          "name": "event",
          "typescriptType": "React.FocusEvent<HTMLInputElement>",
          "extract": {
            "value": "target.value",
            "type": "type"
          }
        }
      ],
      "actions": [
        "state.set",
        "service.call"
      ]
    },
    {
      "name": "onBlur",
      "description": "输入框失去焦点时触发。",
      "parameters": [
        {
          "name": "event",
          "typescriptType": "React.FocusEvent<HTMLInputElement>",
          "extract": {
            "value": "target.value",
            "type": "type"
          }
        }
      ],
      "actions": [
        "state.set",
        "form.validate",
        "service.call"
      ]
    },
    {
      "name": "onKeyDown",
      "description": "按下键盘按键时触发，继承自原生 input。",
      "parameters": [
        {
          "name": "event",
          "typescriptType": "React.KeyboardEvent<HTMLInputElement>",
          "extract": {
            "key": "key",
            "code": "code",
            "value": "currentTarget.value"
          }
        }
      ],
      "actions": [
        "state.set",
        "service.call"
      ]
    }
  ],
  "slots": [
    {
      "name": "prefix",
      "description": "输入框内部前缀。",
      "accepts": [
        "text",
        "icon",
        "component",
        "expression"
      ],
      "multiple": false
    },
    {
      "name": "suffix",
      "description": "输入框内部后缀。",
      "accepts": [
        "text",
        "icon",
        "component",
        "expression"
      ],
      "multiple": false
    },
    {
      "name": "addonBefore",
      "description": "输入框外部前置标签。",
      "accepts": [
        "text",
        "icon",
        "component",
        "expression"
      ],
      "multiple": false
    },
    {
      "name": "addonAfter",
      "description": "输入框外部后置标签。",
      "accepts": [
        "text",
        "icon",
        "component",
        "expression"
      ],
      "multiple": false
    }
  ],
  "methods": [
    {
      "name": "focus",
      "description": "聚焦输入框，并可指定光标位置。",
      "parameters": [
        {
          "name": "options",
          "typescriptType": "{ cursor?: 'start' | 'end' | 'all'; preventScroll?: boolean }",
          "optional": true
        }
      ],
      "returns": "void"
    },
    {
      "name": "blur",
      "description": "移除输入框焦点。",
      "parameters": [],
      "returns": "void"
    },
    {
      "name": "select",
      "description": "选中输入框全部内容。",
      "parameters": [],
      "returns": "void"
    },
    {
      "name": "setSelectionRange",
      "description": "设置输入框文本选择范围。",
      "parameters": [
        {
          "name": "start",
          "typescriptType": "number"
        },
        {
          "name": "end",
          "typescriptType": "number"
        },
        {
          "name": "direction",
          "typescriptType": "'forward' | 'backward' | 'none'",
          "optional": true
        }
      ],
      "returns": "void"
    }
  ],
  "examples": [
    {
      "id": "username-input",
      "component": "Input",
      "props": {
        "value": {
          "$bind": "state.form.username",
          "fallback": ""
        },
        "placeholder": "请输入用户名",
        "allowClear": true,
        "prefix": {
          "$node": "icon",
          "name": "UserOutlined"
        }
      },
      "events": {
        "onChange": [
          {
            "action": "state.set",
            "args": {
              "path": "form.username",
              "value": {
                "$event": "target.value"
              }
            }
          }
        ],
        "onPressEnter": [
          {
            "action": "form.submit",
            "args": {
              "formId": "login-form"
            }
          }
        ]
      }
    }
  ]
}
