{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcode-agent.local/schemas/antd-v4/catalog.schema.json",
  "title": "Ant Design v4 component catalog",
  "type": "object",
  "required": [
    "library",
    "libraryVersion",
    "schemaVersion",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "library": {
      "const": "antd"
    },
    "libraryVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposal",
        "stable",
        "deprecated"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "descriptionFile",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "descriptionFile": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "stable",
              "deprecated"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

