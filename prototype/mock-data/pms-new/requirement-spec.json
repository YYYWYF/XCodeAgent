{
  "app_info": {
    "name": "武汉分行需求回检系统",
    "description": "武汉分行的需求回检管理平台，覆盖需求回检填报与审核闭环。",
    "terminal": "PC",
    "layout": "side 侧边导航布局",
    "target_audience": "分行回检填报人与审核人"
  },
  "user_roles": [
    {
      "id": "recheck-reporter",
      "name": "回检填报人",
      "description": "提交需求回检单，跟踪回检状态。",
      "permissions": [
        "提交回检",
        "查看我的回检"
      ]
    },
    {
      "id": "recheck-reviewer",
      "name": "回检审核人",
      "description": "审核回检单。",
      "permissions": [
        "审核回检"
      ]
    }
  ],
  "feature_modules": [
    {
      "id": "recheck_management",
      "name": "需求回检管理",
      "description": "覆盖回检流程说明、个人回检记录查询与状态跟踪。",
      "priority": "must"
    }
  ],
  "pages": [
    {
      "pageId": "recheck-introduction",
      "name": "回检介绍",
      "path": "/recheck-introduction",
      "module_id": "recheck_management",
      "description": "静态介绍需求回检场景与处理流程"
    },
    {
      "pageId": "my-rechecks",
      "name": "我的回检",
      "path": "/my-rechecks",
      "module_id": "recheck_management",
      "description": "回检填报"
    }
  ],
  "apis": [
    {
      "id": "query_my_rechecks",
      "name": "查询我的回检",
      "method": "GET",
      "path": "/api/rechecks/my",
      "summary": "查看自己提交的回检记录及处理状态",
      "request": [
        {
          "name": "处理状态",
          "required": false,
          "summary": "按处理状态筛选，不传返回全部",
          "code": "status"
        }
      ],
      "response": [
        {
          "code": "recheck_id",
          "name": "回检单号"
        },
        {
          "code": "project_name",
          "name": "关联项目"
        },
        {
          "code": "status",
          "name": "处理状态"
        },
        {
          "code": "created_by",
          "name": "申请人"
        },
        {
          "code": "created_at",
          "name": "提交时间"
        }
      ],
      "used_by_pages": [
        "my-rechecks"
      ]
    },
    {
      "id": "query_recheck_reviewer",
      "name": "查询审核人信息",
      "method": "GET",
      "path": "/api/rechecks/{id}/reviewer",
      "summary": "了解本次回检的审核负责人",
      "request": [
        {
          "name": "id",
          "required": true,
          "summary": "回检单号（路径参数）",
          "code": "id"
        }
      ],
      "response": [
        {
          "code": "userName",
          "name": "姓名"
        },
        {
          "code": "department",
          "name": "所属部门"
        }
      ],
      "used_by_pages": [
        "my-rechecks"
      ]
    }
  ],
  "business_flows": [
    {
      "id": "recheck-flow",
      "name": "需求回检流程",
      "description": "回检填报与审核。",
      "steps": [
        {
          "step_id": 1,
          "description": "提交回检单"
        },
        {
          "step_id": 2,
          "description": "审核回检单"
        }
      ]
    }
  ],
  "test_case_estimate": {
    "total": 6,
    "groups": [
      {
        "id": "introduction",
        "label": "回检介绍",
        "total": 1,
        "coverage": "页面访问、流程说明与进入回检入口"
      },
      {
        "id": "my-rechecks",
        "label": "我的回检",
        "total": 3,
        "coverage": "列表加载、回检提交、必填校验与状态筛选"
      },
      {
        "id": "query-api",
        "label": "回检查询接口",
        "total": 2,
        "coverage": "当前用户数据、分页参数与状态筛选"
      }
    ]
  },
  "acceptance_criteria": [
    "回检介绍无需接口即可完整展示",
    "可提交回检单并跟踪状态"
  ],
  "assumptions": [
    "角色与流程细节待需求分析阶段澄清确认"
  ]
}
