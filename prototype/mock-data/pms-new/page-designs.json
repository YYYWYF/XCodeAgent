    "api_dependencies": [
      {
        "apiContractId": "rechecks",
        "method": "GET",
        "path": "/api/rechecks/my",
        "purpose": "我的回检单分页查询"
      },
      {
        "apiContractId": "rechecks",
        "method": "POST",
        "path": "/api/rechecks",
        "purpose": "提交需求回检单"
      }
    ],
    "response_bindings": [
      {
        "endpointId": "ep-my-rechecks",
        "sourcePath": "data.list",
        "target": "table.rows"
      }
    ],
    "acceptance_criteria": [
      "可提交回检单并校验必填项",
      "已提交回检单状态可跟踪",
      "驳回回检可查看整改要求"
    ]
  },
